# Copiez ce fichier sous le nom .env, puis collez votre clé API Anthropic après le signe =
# (clé à créer sur https://platform.claude.com, rubrique API Keys).
ANTHROPIC_API_KEY=

# Facultatif
# PORT=3000
# Pour ouvrir le cartable depuis une tablette ou un autre ordinateur de la maison :
# HOST=0.0.0.0
# MODEL=claude-opus-5-5

# Chiffrement de la base data/cartable.duckdb (conseillé). À choisir AVANT le premier lancement
# et à noter en lieu sûr : sans cette phrase, les données sont illisibles.
# DB_KEY=

# IA locale avec Ollama (https://ollama.com) au lieu de Claude : gratuit, mais plus lent et moins fiable.
# IA=ollama              (claude par défaut si une clé API est présente)
# IA_QUICK=claude        (facultatif : un autre choix pour les petites réponses)
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_URL=http://127.0.0.1:11434   (ou l'adresse d'un autre PC de la maison)
# OLLAMA_CTX=16384
