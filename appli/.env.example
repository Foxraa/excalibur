# L'IA se choisit dans l'espace parents du cartable, qui écrit ce fichier lui-même.
# Rien n'est obligatoire ici. Les réglages à la main sont plus bas.

# Facultatif
# PORT=3000
# Pour ouvrir le cartable depuis une tablette ou un autre ordinateur de la maison :
# HOST=0.0.0.0
# MODEL=claude-opus-5-5

# Chiffrement de la base data/cartable.duckdb (conseillé). À choisir AVANT le premier lancement
# et à noter en lieu sûr : sans cette phrase, les données sont illisibles.
# DB_KEY=

# IA : ollama ou claude. Claude par défaut si une clé API est présente.
# IA=ollama
# IA_QUICK=claude        (facultatif : un autre choix pour les petites réponses)
# OLLAMA_MODEL=gemma4:e4b
# OLLAMA_URL=http://192.168.1.20:11434   (si Ollama tourne sur un autre ordinateur de la maison)
# OLLAMA_CTX=16384
# Clé créée sur https://platform.claude.com, rubrique API Keys :
# ANTHROPIC_API_KEY=
